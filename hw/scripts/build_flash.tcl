# Build the QSPI slot image (MCS) from the compressed partials and emit the
# matching compiled-in slot manifest (sw/tricorder-rtos/src/slots.h).
# Layout: 1 MiB slots — a@0x900000 b@0xA00000 pdm@0xB00000 sonar@0xC00000.
# Run from repo root: vivado -mode batch -source hw/scripts/build_flash.tcl

set out build/flash
file mkdir $out

set slots {a 0x00900000 b 0x00A00000 pdm 0x00B00000 sonar 0x00C00000}
set sigs  {a 0xA5A5A5A5 b 0x5B5B5B5B pdm 0x9D3A0001 sonar 0x50A40001}

# App boot image for the LMB bootloader (needs the freshly built ELF)
exec python3 tools/mkbootimg.py \
    build/vitis-ws/tricorder_rtos/build/tricorder_rtos.elf $out/bootimg.bin
set loaddata "up 0x00D00000 $out/bootimg.bin"
set h [open sw/tricorder-rtos/src/slots.h w]
puts $h "/* Generated by hw/scripts/build_flash.tcl — do not edit."
puts $h " * QSPI slot manifest; flash appears at XIP window 0x60000000. */"
puts $h "#ifndef SLOTS_H"
puts $h "#define SLOTS_H"
puts $h "#define QSPI_XIP_BASE 0x60000000u"
foreach {rm off} $slots {
    set f build/dfx/rm_${rm}_partial.bin
    if {![file exists $f]} { puts "FLASH: FAIL (missing $f)"; exit 1 }
    set len [file size $f]
    append loaddata " up $off $f"
    set u [string toupper $rm]
    puts $h "#define SLOT_${u}_OFF  ${off}u"
    puts $h "#define SLOT_${u}_LEN  ${len}u"
}
puts $h "#endif"
close $h

# Two images: the boot bitstream needs standard config bit order, the
# data slots are proven to need -disablebitswap (entry 25) - write_cfgmem
# flags are global, so emit two MCS files and program both ranges.
write_cfgmem -force -format mcs -size 16 -interface SPIx4 \
    -loadbit "up 0x0 build/dfx/full_a.bit" $out/boot.mcs
write_cfgmem -force -format mcs -size 16 -interface SPIx1 -disablebitswap \
    -loaddata $loaddata $out/slots.mcs
puts "FLASH: PASS -> $out/boot.mcs + $out/slots.mcs + sw/tricorder-rtos/src/slots.h"
exit 0
